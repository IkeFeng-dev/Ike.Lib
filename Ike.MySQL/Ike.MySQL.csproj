<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 只保留支持的框架 -->
    <TargetFrameworks>netstandard2.0;net48</TargetFrameworks>
    <RootNamespace>Ike</RootNamespace>
    <PackageId>Ike.MySQL</PackageId>
    <AssemblyName>Ike.MySQL</AssemblyName>
    <Version>0.0.4</Version>
    <ProduceReferenceAssembly>True</ProduceReferenceAssembly>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>MySQL 基础操作库</Title>
    <Authors>IkeFeng</Authors>
    <Description>MySQL 基础操作库</Description>
    <Copyright>© 2026 IkeFeng. All rights reserved.</Copyright>
    <PackageIcon>ico.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>
     [2026年8月4日14:13:49]
     一,构造函数新增线程池参数
	 二,新增短连接方式
    </PackageReleaseNotes>
    <PackageTags>MYSQL</PackageTags>
    <AssemblyVersion>0.0.0.4</AssemblyVersion>
    <FileVersion>0.0.0.4</FileVersion>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    
    
  </PropertyGroup>


  <PropertyGroup Condition="'$(TargetFramework)'=='netstandard2.0'">
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(TargetFramework)'=='net48'">
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\ico.png" Link="ico.png">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
    <None Include="..\LICENSE.txt" Link="LICENSE.txt">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- 统一使用 MySQL 8.4.0 -->
  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="8.4.0" />
  </ItemGroup>
  
</Project>