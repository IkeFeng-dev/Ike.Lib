<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;netstandard2.1;net46;net461;net462;net47;net471;net472;net48;net481;netcoreapp3.1;net6.0</TargetFrameworks>
		<!-- 根据不同框架启用不同特性 -->
		<UseWindowsForms Condition="'$(TargetFramework)' == 'net46' or '$(TargetFramework)' == 'net461' or '$(TargetFramework)' == 'net462' or '$(TargetFramework)' == 'net471' or '$(TargetFramework)' == 'net472' or '$(TargetFramework)' == 'net48' or '$(TargetFramework)' == 'net481' or '$(TargetFramework)' == 'net6.0-windows'">true</UseWindowsForms>
		<UseWPF Condition="'$(TargetFramework)' == 'net46' or '$(TargetFramework)' == 'net461' or '$(TargetFramework)' == 'net462' or '$(TargetFramework)' == 'net471' or '$(TargetFramework)' == 'net472' or '$(TargetFramework)' == 'net48' or '$(TargetFramework)' == 'net481' or '$(TargetFramework)' == 'net6.0-windows'">true</UseWPF>
		
		<AllowUnsafeBlocks>False</AllowUnsafeBlocks>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>ico.png</PackageIcon>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<Version>6.0.0</Version>
		<AssemblyVersion>6.0.0.0</AssemblyVersion>
		<FileVersion>6.0.0.0</FileVersion>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<RepositoryUrl></RepositoryUrl>	
		<PackageProjectUrl></PackageProjectUrl>
		<Description>C# 通用方法集成库,包括但不限于文件操作(INI,LOG),控制台,FTP,文本,WinAPI,Socket,队列,加解密,数据转换等...</Description>
		<Title>C# 通用方法库</Title>
		<PackageReleaseNotes>
			[2026-7-23 09:23:31]
			一,优化整个类结构
			二,新增GetInfo类,获取程序,设备信息等
		</PackageReleaseNotes>
		<Copyright>© 2026 IkeFeng.  All rights reserved.</Copyright>
		<PackageTags>Socket;ini;Text;Array;FTP;WinAPI;Log;Console</PackageTags>
		<RootNamespace>Ike</RootNamespace>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<GenerateAssemblyInfo>False</GenerateAssemblyInfo>
		<DebugType>embedded</DebugType>
	</PropertyGroup>	

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<GenerateAssemblyInfo>False</GenerateAssemblyInfo>
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\ico.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>

	</ItemGroup>

	<!-- .NET Framework 4.6 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net46'">
		<PackageReference Include="System.Net.Sockets" Version="4.3.0" />
		<PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
		<PackageReference Include="System.Memory" Version="4.5.4" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="System.Drawing" />
		<PackageReference Include="System.ValueTuple" Version="4.5.0" />
		<Reference Include="System.Windows.Forms.DataVisualization" />
	</ItemGroup>

	<!-- .NET Framework 4.6.1 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net461'">
		<PackageReference Include="System.Net.Sockets" Version="4.3.0" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="System.Drawing" />
		<PackageReference Include="System.ValueTuple" Version="4.5.0" />
		<Reference Include="System.Windows.Forms.DataVisualization" />
	</ItemGroup>
	<!-- .NET Framework 4.6.2 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net462'">
		<PackageReference Include="System.Net.Sockets" Version="4.3.0" />
		<PackageReference Include="System.ValueTuple" Version="4.5.0" />
		<Reference Include="System.Windows.Forms.DataVisualization" />
	</ItemGroup>
	<!-- .NET Framework 4.7 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net47'">
		<PackageReference Include="System.Net.Sockets" Version="4.3.0" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="System.Drawing" />
		<Reference Include="System.Windows.Forms.DataVisualization" />
	</ItemGroup>
	
	<!-- .NET Framework 4.8 -->
	<ItemGroup Condition=" '$(TargetFramework)' == 'net48'">
		<Reference Include="System.Windows.Forms" />
		<Reference Include="System.Drawing" />
		<Reference Include="System.Windows.Forms.DataVisualization" />
	</ItemGroup>
	
	<!-- netstandard2.0 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		
	</ItemGroup>


	<!-- netstandard2.1 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
		
	</ItemGroup>

</Project>
